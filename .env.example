# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# Cryptographic Secrets (MUST be at least 32 characters in production)
# Generate via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_random_secret_at_least_32_chars_long_in_production
OTP_HMAC_SECRET=replace_with_random_secret_at_least_32_chars_long_in_production
QR_SIGNING_SECRET=replace_with_random_secret_at_least_32_chars_long_in_production
WEBHOOK_SECRET=replace_with_random_secret_at_least_32_chars_long_in_production

# Development Switches (MUST be false or absent in production; server REFUSES to start if true in production)
SEED_DEMO=true
SEED_DEMO_PIN=123456
ALLOW_DEV_OTP=true
ENABLE_PAYMENT_SIMULATOR=true

# Database Path
DB_PATH=./merchant.db

# WebAuthn Configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Apex Merchant App
WEBAUTHN_ORIGIN=http://localhost:3000

# Transaction & Payout Limits (in paise)
ORDER_MAX_AMOUNT_PAISE=10000000
PAYOUT_MAX_PER_TXN_PAISE=5000000
PAYOUT_MAX_PER_DAY_PAISE=20000000

# SMS Provider Configuration
SMS_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TE_ID=
